# ── Heavy binary inputs — shipped via the Zenodo archive, NOT git ──────────────
# DEMs, HANDs, raingrid, masks, ground-truth rasters. The working tree is
# self-contained on disk; `git clone` alone is not — pair it with the Zenodo
# data archive (see repro/DATA_MANIFEST.md).
*.tif
*.tiff

# Downloadable flood-observation source archives (DFO / GFM / ARIA)
*.zip

# ── Regenerable outputs / scratch ─────────────────────────────────────────────
outputs/*
!outputs/.gitkeep
cache/
logs/
*.log

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# ── Editor / OS / session-local ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.claude/settings.local.json
zenodo/
# LibreOffice/Office lock files, created whenever a doc in the tree is opened
.~lock.*#
~$*

# ── Damage module raw inputs (re-fetchable; Zenodo, not git) ──
damage/data/ghsl/
damage/data/osm/
damage/data/exposure/
